# Set these as server-side Sites environment variables. Never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional text-tutor alternative. OpenAI is still required for voice transcription.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Exact Site-scoped ChatGPT IDs, comma separated. Never automatically grant the first visitor admin access.
ADMIN_CHATGPT_USER_IDS=
